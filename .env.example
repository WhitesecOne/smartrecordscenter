# Canonical site URL. Required in production: without it robots.txt blocks all crawlers.
NEXT_PUBLIC_SITE_URL=https://smartrecordscenter.com

# Google Analytics 4 measurement ID. Optional; analytics loads only after cookie consent.
NEXT_PUBLIC_GA_ID=

# Demo-request email delivery through Resend (https://resend.com). Without a key, requests are only written to the server log.
RESEND_API_KEY=
# Optional overrides. CONTACT_FROM must use a domain verified in Resend, e.g. "Smart Records Center <demo@smartrecordscenter.com>".
CONTACT_FROM=
CONTACT_TO=
